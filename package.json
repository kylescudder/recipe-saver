{
  "name": "recipe-saver",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "bun --watch server/index.ts",
    "build": "vite build",
    "start": "bun server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun server/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test server/*.test.ts tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "prepare": "husky",
    "test:connections": "bun deploy/test-connection-budget.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.26.2",
    "@clerk/react": "6.18.1",
    "@clerk/themes": "2.4.29",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@hookform/resolvers": "6.0.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.5.0",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.90.12",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "8.21.3",
    "@trpc/client": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "8.3.5"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.31"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown"
