# Runtime: protected host .env; owner credentials are used only for migrations.
DATABASE_URL=postgres://recipe_saver_runtime:REPLACE@postgres:5432/recipe_saver
APP_ORIGIN=https://recipes.kylescudder.co.uk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Public build argument; must identify the SAME Clerk instance as runtime.
VITE_CLERK_PUBLISHABLE_KEY=
# Immutable, provenance-verified release chosen by deploy-core.
RECIPE_SAVER_IMAGE=ghcr.io/kylescudder/recipe-saver@sha256:REPLACE
